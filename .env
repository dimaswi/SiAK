# ========================
# Application
# ========================
APP_ENV=development
APP_PORT=8086
ADMIN_PORT=5176
PUBLIC_PORT=3001
DATABASE_PORT=5434
NGINX_PORT=80
BACKEND_CONTAINER_PORT=8080
ADMIN_CONTAINER_PORT=80
PUBLIC_CONTAINER_PORT=3000
DATABASE_CONTAINER_PORT=5432
ADMIN_DOMAIN=siak.dimaswysnu.com
PUBLIC_DOMAIN=sekolah.dimaswysnu.com

# ========================
# Frontend / Next Runtime
# ========================
VITE_API_BASE=/api
VITE_ASSET_BASE=
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_ASSET_BASE=
INTERNAL_API_BASE=http://siak_backend:8080/api
INTERNAL_BACKEND_ORIGIN=http://siak_backend:8080

# ========================
# Database
# ========================
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=siak_user
DB_PASSWORD=siak_password
DB_NAME=siak_db
DB_SSLMODE=disable

# ========================
# JWT
# ========================
JWT_SECRET=change-this-jwt-secret-key-in-production

# ========================
# Frontend URL (primary CORS origin)
# ========================
FRONTEND_URL=https://siak.dimaswysnu.com

# ========================
# Additional CORS origins
# Comma-separated list
# ========================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176,http://localhost:3001,http://127.0.0.1:3001,https://siak.dimaswysnu.com,https://sekolah.dimaswysnu.com