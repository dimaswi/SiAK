upstream siak_admin_upstream {
    server siak_fronted:${ADMIN_CONTAINER_PORT};
}

upstream siak_public_upstream {
    server siak_public:${PUBLIC_CONTAINER_PORT};
}

upstream siak_backend_upstream {
    server siak_backend:${BACKEND_CONTAINER_PORT};
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 25m;

    location /api/ {
        proxy_pass http://siak_backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://siak_backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://siak_public_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

