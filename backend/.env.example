# SiAK Environment Variables
# Copy this file to .env and adjust values as needed

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=siak_user
DB_PASSWORD=siak_password
DB_NAME=siak_db
DB_SSLMODE=disable

# Server
SERVER_PORT=8080

# JWT
JWT_SECRET=ganti-secret-ini-di-production-dengan-string-yang-sangat-panjang
